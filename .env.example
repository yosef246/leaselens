# LeaseLens — Environment Variables (TEMPLATE)
# Copy to .env.local and fill real values. .env.local is git-ignored; this file is committed.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never import it into a client component.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Anthropic (Claude sonnet-5) ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# --- OpenAI (embeddings only) ---
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX

# --- PostHog (analytics, P7) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# --- Feature flags ---
# Live Knesset scraping stays OFF (data/laws/*.txt is source of truth, per DECISIONS.md D1)
FEATURE_LAW_SCRAPING_ENABLED=false
